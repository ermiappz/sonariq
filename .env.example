# Copy to .env (never commit .env)
APS_CLIENT_ID=
APS_CLIENT_SECRET=
# AI explanations: Gemini on Vertex AI via the Google Gen AI SDK (gcloud credentials). SONARIQ_AI=off disables it.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_LOCATION=eu
GOOGLE_CLOUD_PROJECT=<project>
# Simulate (evacuation) is off unless this is set (make api-sim sets it)
# SIMULATE_ENABLED=1
# RAG: local index by default; set to use the Vertex AI RAG Engine corpus instead
# SQ_RAG_CORPUS=projects/<project>/locations/europe-west4/ragCorpora/<id>
