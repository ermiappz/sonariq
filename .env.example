# Copy to .env (never commit .env)
APS_CLIENT_ID=
APS_CLIENT_SECRET=
# OpenAI-compatible endpoint for explanations (optional; without it the engine's own wording is used)
LLM_BASE_URL=https://us-south1-aiplatform.googleapis.com/v1/projects/<project>/locations/us-south1/endpoints/openapi
LLM_MODEL=qwen/qwen3-235b-a22b-instruct-2507-maas
# LLM_API_KEY=   # optional; default is `gcloud auth print-access-token`
